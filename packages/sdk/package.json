{
  "name": "@make-software/cspr-trade-mcp-sdk",
  "version": "0.6.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && mkdir -p dist/assets && cp src/assets/proxy_caller.wasm dist/assets/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "casper-js-sdk": "^5.0.11",
    "big.js": "^6.2.2",
    "blakejs": "^1.2.1",
    "@noble/hashes": "^1.7.0"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "description": "TypeScript SDK for CSPR.trade DEX API on Casper Network"
}
