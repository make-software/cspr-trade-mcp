---
export interface NavItem {
  href: string;
  label: string;
  external?: boolean;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

export const navItems: NavItem[] = [
  { href: '/docs/getting-started', label: 'Getting Started' },
  { href: '/docs/agent', label: 'Agent Guide' },
  { href: '/docs/self-hosting', label: 'Self-Hosting' },
  { href: '/docs/sdk', label: 'SDK Reference' },
  { href: '/docs/mcp', label: 'MCP Server Reference' },
];

export const externalItems: NavItem[] = [
  { href: 'https://github.com/make-software/cspr-trade-mcp', label: 'GitHub', external: true },
  { href: 'https://cspr.trade', label: 'cspr.trade', external: true },
];
---

<aside class="glass-card hidden rounded-[1.5rem] p-4 lg:block lg:sticky lg:top-24">
  <nav class="space-y-1">
    {navItems.map((item) => {
      const active = currentPath === item.href;
      return (
        <a
          href={item.href}
          class:list={[
            'block rounded-xl border px-4 py-3 text-sm font-medium transition',
            active
              ? 'border-[var(--color-accent)]/50 bg-[rgba(255,0,18,0.08)] text-white'
              : 'border-transparent text-text-secondary hover:border-white/10 hover:bg-white/5 hover:text-white',
          ]}
        >
          {item.label}
        </a>
      );
    })}
  </nav>

  <div class="my-4 border-t border-white/8"></div>

  <div class="space-y-1">
    {externalItems.map((item) => (
      <a href={item.href} target="_blank" rel="noreferrer" class="block rounded-xl border border-transparent px-4 py-3 text-sm font-medium text-text-secondary transition hover:border-white/10 hover:bg-white/5 hover:text-white">
        {item.label}
      </a>
    ))}
  </div>
</aside>
