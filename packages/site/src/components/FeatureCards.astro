---
const features = [
  {
    title: 'Instant Connection',
    body: 'Point your MCP client at mcp.cspr.trade/mcp and start querying. No API keys, no local setup, no dependencies.',
  },
  {
    title: '24 Public MCP Tools',
    body: 'Market data, price history, pre-trade analysis, swaps, liquidity operations, and account queries — one clean public tool surface.',
  },
  {
    title: 'Non-Custodial',
    body: 'Transactions are built remotely but signed locally. Private keys stay on your machine, where they belong.',
  },
  {
    title: 'Pre-Trade Intelligence',
    body: 'Analyze price impact, slippage, and liquidity depth before executing. Agents get proceed/caution/high_risk recommendations — no more blind swaps.',
  },
  {
    title: 'Run Your Own',
    body: 'Need testnet or a private instance? Install the npm packages and run locally via stdio or HTTP in minutes. Add signer mode for local signing.',
  },
];
---

<section class="py-12 sm:py-16">
  <div class="container-shell">
    <div class="grid gap-4 md:grid-cols-2">
      {features.map((feature) => (
        <article class="glass-card rounded-[1.5rem] p-6 transition hover:-translate-y-1 hover:border-white/12 hover:bg-white/[0.045]">
          <h3 class="text-xl font-semibold text-white">{feature.title}</h3>
          <p class="mt-3 text-base leading-7 text-text-secondary">{feature.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
