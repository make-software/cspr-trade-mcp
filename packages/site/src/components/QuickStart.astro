---
import CopyCodeButton from './CopyCodeButton.astro';
import CopyCodeScript from './CopyCodeScript.astro';

const publicConfig = `{
  "mcpServers": {
    "cspr-trade": {
      "url": "https://mcp.cspr.trade/mcp"
    }
  }
}`;

const agentSkillUrl = `https://mcp.cspr.trade/SKILL.md`;

const selfHostedConfig = `CSPR_TRADE_NETWORK=testnet CSPR_TRADE_TRANSPORT=http CSPR_TRADE_PORT=3001 \\
  npx @make-software/cspr-trade-mcp`;
---

<section class="py-12 sm:py-16">
  <div class="container-shell">
    <div class="mb-8 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-[var(--color-accent)]">Quick start</p>
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Connect in seconds</h2>
    </div>

    <div class="grid gap-4 xl:grid-cols-2">
      <article class="glass-card rounded-[1.5rem] p-6">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h3 class="text-lg font-semibold text-white">Public endpoint (recommended)</h3>
          <a href="/docs/getting-started" class="text-sm font-medium text-[var(--color-accent)]">Full guide →</a>
        </div>
        <p class="mb-4 text-sm text-text-secondary">
          Add to Claude Desktop, Cursor, or any MCP client. Mainnet, no setup needed.
        </p>
        <div class="code-block">
          <CopyCodeButton code={publicConfig} />
          <pre><code>{publicConfig}</code></pre>
        </div>
      </article>

      <article class="glass-card rounded-[1.5rem] p-6">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h3 class="text-lg font-semibold text-white">Agent SKILL.md</h3>
          <a href="/SKILL.md" class="text-sm font-medium text-[var(--color-accent)]">View SKILL.md →</a>
        </div>
        <p class="mb-4 text-sm text-text-secondary">
          Point your AI agent at the SKILL.md for complete workflow instructions — intents, safety checks, signing flows, and error handling.
        </p>
        <div class="code-block">
          <CopyCodeButton code={agentSkillUrl} />
          <pre><code>{agentSkillUrl}</code></pre>
        </div>
      </article>
    </div>

    <div class="mt-4 grid gap-4 xl:grid-cols-1">
      <article class="glass-card rounded-[1.5rem] p-6">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h3 class="text-lg font-semibold text-white">Self-hosted (testnet / private)</h3>
          <a href="/docs/self-hosting" class="text-sm font-medium text-[var(--color-accent)]">Setup guide →</a>
        </div>
        <p class="mb-4 text-sm text-text-secondary">
          Run your own instance for testnet development or private deployments.
        </p>
        <div class="code-block">
          <CopyCodeButton code={selfHostedConfig} />
          <pre><code>{selfHostedConfig}</code></pre>
        </div>
      </article>
    </div>
  </div>
  <CopyCodeScript />
</section>
