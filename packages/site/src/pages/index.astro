---
import Architecture from '../components/Architecture.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import QuickStart from '../components/QuickStart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CSPR.trade MCP" description="AI agent integration for CSPR.trade DEX on Casper Network">
  <Navbar />
  <main>
    <Hero />
    <Architecture />
    <FeatureCards />
    <QuickStart />

    <section class="py-12 sm:py-16">
      <div class="container-shell">
        <div class="glass-card rounded-[1.75rem] p-6 sm:p-8">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-[var(--color-accent)]">Public endpoint</p>
          <h2 class="text-2xl font-bold text-white sm:text-3xl">Mainnet endpoint is live</h2>
          <p class="mt-4 text-base leading-7 text-text-secondary">
            MCP: <code>https://mcp.cspr.trade/mcp</code><br />
            Health: <code>https://mcp.cspr.trade/health</code>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
